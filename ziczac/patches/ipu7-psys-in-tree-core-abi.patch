diff --git a/Makefile b/Makefile
index db7ae5b..b049207 100644
--- a/Makefile
+++ b/Makefile
@@ -32,6 +32,8 @@ ifeq ($(call version_lt,$(KERNEL_VERSION),$(KV_IPU7_ISYS)),true)
 obj-y += drivers/media/pci/intel/ipu7/
 else
 obj-y += drivers/media/pci/intel/ipu7/psys/
+# PSys shares core-owned objects with the in-tree driver, not the vendor core.
+subdir-ccflags-y += -DIPU7_USE_IN_TREE_CORE
 endif
 
 # For ACPI build: add platform drivers
diff --git a/README.md b/README.md
index 6163a12..5a3cbc3 100644
--- a/README.md
+++ b/README.md
@@ -53,6 +53,19 @@ Three ways are available:
 ### 2. Out-of-tree build
 - Requires kernel headers installed on build machine
 - Requires dependencies enabled in kernel, and patches under `patch/<kernel-version>` (not `in-tree-build`) applied to the kernel you will run the modules on
+- For kernels older than v6.17, the top-level Makefile builds the vendor core,
+  ISYS and PSys. For v6.17 and newer, it builds only PSys against the in-tree
+  core and ISYS, and defines `IPU7_USE_IN_TREE_CORE` to select the matching
+  shared declarations. Keep that definition when using a custom build system
+  for PSys with the in-tree core.
+- This installed-revision backport targets the unmodified upstream core ABI.
+  Downstream cores with vendor debugfs or task/TLB extensions require matching
+  declarations; use the newer upstream candidate's explicit ABI selection
+  rather than assuming this backport supports those layouts.
+- The in-tree core does not provide the vendor FW-task/TLB coordination
+  extensions. PSys-only builds must not access those fields; this build mode
+  does not add that coordination to the in-tree core. With debugfs enabled,
+  PSys firmware logs are under `/sys/kernel/debug/ipu7-psys/fwlog` in this mode.
 - To build and install:
 	```sh
 	make -j`nproc` && sudo make modules_install && sudo depmod -a
diff --git a/drivers/media/pci/intel/ipu7/ipu7-bus.h b/drivers/media/pci/intel/ipu7/ipu7-bus.h
index eb9d0c9..0ccab57 100644
--- a/drivers/media/pci/intel/ipu7/ipu7-bus.h
+++ b/drivers/media/pci/intel/ipu7/ipu7-bus.h
@@ -47,11 +47,13 @@ struct ipu7_bus_device {
 	dma_addr_t boot_config_dma_addr;
 	u32 boot_config_size;
 
+#ifndef IPU7_USE_IN_TREE_CORE
 	/* Serialize FW message buffer or task queue acquisition against
 	 * TLB invalidation.
 	 */
 	struct mutex acquire_fw_task_buffer_lock;
 	unsigned int (*get_running_fw_task_count)(struct ipu7_bus_device *adev);
+#endif
 };
 
 struct ipu7_auxdrv_data {
diff --git a/drivers/media/pci/intel/ipu7/ipu7-mmu.h b/drivers/media/pci/intel/ipu7/ipu7-mmu.h
index e4bc485..394f8a0 100644
--- a/drivers/media/pci/intel/ipu7/ipu7-mmu.h
+++ b/drivers/media/pci/intel/ipu7/ipu7-mmu.h
@@ -402,7 +402,11 @@ struct ipu7_mmu {
 	bool ready;
 	spinlock_t ready_lock;	/* Serialize access to bool ready */
 
+#ifdef IPU7_USE_IN_TREE_CORE
+	void (*tlb_invalidate)(struct ipu7_mmu *mmu);
+#else
 	void (*tlb_invalidate)(struct ipu7_mmu *mmu, int mmu_id);
+#endif
 };
 
 struct ipu7_mmu *ipu7_mmu_init(struct device *dev,
