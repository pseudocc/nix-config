diff --git a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
index ce16e4c..97de7e6 100644
--- a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
+++ b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
@@ -1005,6 +1005,7 @@ unlock:
 	return NULL;
 }
 
+#ifndef IPU7_USE_IN_TREE_CORE
 static unsigned int ipu7_psys_get_running_fw_task_count(
 					      struct ipu7_bus_device *adev)
 {
@@ -1025,6 +1026,7 @@ static unsigned int ipu7_psys_get_running_fw_task_count(
 
 	return count;
 }
+#endif
 
 static long ipu_psys_task_request(struct ipu_psys_task_request *task,
 				  struct ipu7_psys_fh *fh)
@@ -1038,9 +1040,13 @@ static long ipu_psys_task_request(struct ipu_psys_task_request *task,
 		return -EINVAL;
 	}
 
+#ifndef IPU7_USE_IN_TREE_CORE
 	mutex_lock(&psys->adev->acquire_fw_task_buffer_lock);
+#endif
 	tq = ipu7_psys_get_task_queue(fh->ip, task);
+#ifndef IPU7_USE_IN_TREE_CORE
 	mutex_unlock(&psys->adev->acquire_fw_task_buffer_lock);
+#endif
 	if (!tq) {
 		dev_err(&psys->dev, "Failed to get task queue\n");
 		return -EINVAL;
@@ -1350,7 +1356,7 @@ static int ipu7_psys_init_debugfs(struct ipu7_psys *psys)
 {
 	struct dentry *file;
 	struct dentry *dir;
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
+#ifndef IPU7_USE_IN_TREE_CORE
 	dir = debugfs_create_dir("psys", psys->adev->isp->ipu7_dir);
 #else
 	dir = debugfs_create_dir("ipu7-psys", NULL);
@@ -1466,8 +1472,10 @@ static int ipu7_psys_probe(struct auxiliary_device *auxdev,
 	}
 
 	dev_set_drvdata(dev, psys);
+#ifndef IPU7_USE_IN_TREE_CORE
 	adev->get_running_fw_task_count =
 		ipu7_psys_get_running_fw_task_count;
+#endif
 	mutex_unlock(&ipu7_psys_mutex);
 #ifdef CONFIG_DEBUG_FS
 	psys_fw_log_init(psys);
@@ -1503,7 +1511,9 @@ static void ipu7_psys_remove(struct auxiliary_device *auxdev)
 	struct ipu7_psys *psys = dev_get_drvdata(&auxdev->dev);
 	struct device *dev = &auxdev->dev;
 
+#ifndef IPU7_USE_IN_TREE_CORE
 	psys->adev->get_running_fw_task_count = NULL;
+#endif
 #ifdef CONFIG_DEBUG_FS
